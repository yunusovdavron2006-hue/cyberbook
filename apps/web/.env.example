# Web app environment variables.
# Copy to .env.local (dev) or provide at runtime/build in your deployment.

# Internal origin the Next server proxies `/api/v1/*` requests to.
# The browser talks to the web app's own origin, so this only needs to be
# reachable from the server process. Default: http://localhost:4000
#
# PRODUCTION (Vercel): set this to the public HTTPS origin of the deployed
# CyberBook API, e.g. https://api.cyberbook.uz  (no trailing slash, no
# /api/v1 suffix — the proxy appends /api/v1 itself).
# This value is read by the Next server only; it is never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000

# Optional override: point the BROWSER directly at an absolute API base URL
# instead of using the same-origin proxy. Inlined at build time.
# Leave unset to use the proxy (recommended).
#
# PRODUCTION (Vercel): only set this if the API is served from a different
# origin AND that origin sends CORS headers for your web domain. It is baked
# into the client bundle at build time, so changing it requires a redeploy.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Node.js runtime used by the build. Must satisfy the repo `engines` field
# (node >= 20.11.0). Vercel default is 22.x, which is what the project pins.
# NODE_VERSION=22
