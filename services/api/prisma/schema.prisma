// CyberBook — Prisma schema
// PostgreSQL. Money is stored as BIGINT integer so'm (UZS) — never floats.
// Timestamps are timestamptz (UTC). Club-local times are interpreted in club.timezone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  CLUB_OWNER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  BANNED
}

enum ClubStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum StationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum StationCategoryKey {
  PC
  VIP_PC
  BOOTCAMP
  CONSOLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentMethod {
  PAY_AT_CLUB
  ONLINE
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PricingUnit {
  PER_HOUR
  FLAT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum VerificationPurpose {
  EMAIL
  PHONE
  PASSWORD_RESET
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_REMINDER
  OWNER_NEW_BOOKING
  CLUB_APPROVED
  CLUB_REJECTED
  SUPPORT_UPDATE
  SYSTEM
  LOYALTY_EARNED
  LOYALTY_REDEEMED
  REFERRAL_REWARDED
  GROUP_BOOKING_CREATED
  SUBSCRIPTION_UPDATE
  COMMISSION_CHARGED
}

// --- Advanced features enums -------------------------------------------------

enum PromotionType {
  PERCENT
  FLAT
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST
  REVERSAL
  EXPIRE
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum GroupBookingStatus {
  PENDING
  CONFIRMED
  PARTIALLY_CANCELLED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CommissionStatus {
  PENDING
  CHARGED
  REVERSED
}

enum TicketCategory {
  GENERAL
  BOOKING
  PAYMENT
  CLUB
  ACCOUNT
  TECHNICAL
  COMPLAINT
  REFUND
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique @db.VarChar(160)
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  locale          String     @default("uz") @db.VarChar(5)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile           UserProfile?
  sessions          Session[]
  verificationCode  VerificationCode[]
  ownedClubs        Club[]                 @relation("ClubOwner")
  memberships       ClubMembership[]
  bookings          Booking[]
  bookingEvents     BookingEvent[]
  favorites         Favorite[]
  reviews           Review[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  supportMessages   SupportTicketMessage[]
  auditLogs         AuditLog[]
  maintenanceBlocks MaintenanceBlock[]

  promotionsCreated     Promotion[]               @relation("PromotionCreatedBy")
  promotionRedemptions  PromotionRedemption[]
  checkInTokensCreated  CheckInToken[]            @relation("CheckInTokenCreatedBy")
  checkInTokensConsumed CheckInToken[]            @relation("CheckInTokenConsumedBy")
  loyaltyEntries        LoyaltyLedgerEntry[]      @relation("LoyaltyUser")
  loyaltyEntriesActed   LoyaltyLedgerEntry[]      @relation("LoyaltyActor")
  referralCode          ReferralCode?
  referralsMade         Referral[]                @relation("ReferralReferrer")
  referralReceived      Referral?                 @relation("ReferralReferred")
  groupBookings         GroupBooking[]
  groupParticipants     GroupBookingParticipant[]
  aiInsights            AiInsight[]
  assignedTickets       SupportTicket[]           @relation("TicketAssignee")

  @@map("users")
}

model UserProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  displayName String?   @map("display_name") @db.VarChar(120)
  avatarUrl   String?   @map("avatar_url")
  birthDate   DateTime? @map("birth_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ip        String?   @db.VarChar(60)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationCode {
  id         Int                 @id @default(autoincrement())
  userId     Int                 @map("user_id")
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

// ---------------------------------------------------------------------------
// Clubs, stations, schedules, pricing
// ---------------------------------------------------------------------------

model Club {
  id              Int        @id @default(autoincrement())
  ownerId         Int        @map("owner_id")
  name            String     @db.VarChar(140)
  slug            String     @unique @db.VarChar(160)
  description     String?
  city            String     @default("Tashkent") @db.VarChar(80)
  district        String?    @db.VarChar(80)
  address         String     @db.VarChar(255)
  latitude        Float
  longitude       Float
  phone           String?    @db.VarChar(20)
  status          ClubStatus @default(DRAFT)
  rejectionReason String?    @map("rejection_reason")
  coverImageUrl   String?    @map("cover_image_url")
  timezone        String     @default("Asia/Tashkent") @db.VarChar(40)
  rating          Float      @default(0)
  reviewCount     Int        @default(0) @map("review_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  owner        User             @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  branches     ClubBranch[]
  memberships  ClubMembership[]
  stations     Station[]
  hours        OperatingHours[]
  closures     SpecialClosure[]
  pricingRules PricingRule[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]

  promotions           Promotion[]
  promotionRedemptions PromotionRedemption[]
  groupBookings        GroupBooking[]
  subscriptions        ClubSubscription[]
  commissionEntries    CommissionLedgerEntry[]
  aiInsights           AiInsight[]
  supportTickets       SupportTicket[]

  @@index([status, city])
  @@index([ownerId])
  @@map("clubs")
}

model ClubBranch {
  id        Int     @id @default(autoincrement())
  clubId    Int     @map("club_id")
  name      String  @db.VarChar(140)
  address   String  @db.VarChar(255)
  latitude  Float?
  longitude Float?
  isMain    Boolean @default(true) @map("is_main")

  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  stations Station[]

  @@index([clubId])
  @@map("club_branches")
}

model ClubMembership {
  id        Int            @id @default(autoincrement())
  clubId    Int            @map("club_id")
  userId    Int            @map("user_id")
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_memberships")
}

model StationCategory {
  id      Int                @id @default(autoincrement())
  key     StationCategoryKey @unique
  labelUz String             @map("label_uz") @db.VarChar(60)
  labelRu String             @map("label_ru") @db.VarChar(60)
  labelEn String             @map("label_en") @db.VarChar(60)

  stations     Station[]
  pricingRules PricingRule[]
  promotions   Promotion[]

  @@map("station_categories")
}

model Station {
  id           Int           @id @default(autoincrement())
  clubId       Int           @map("club_id")
  branchId     Int?          @map("branch_id")
  categoryId   Int           @map("category_id")
  label        String        @db.VarChar(60)
  status       StationStatus @default(ACTIVE)
  specs        Json?
  pricePerHour BigInt        @map("price_per_hour") // base hourly price, integer UZS
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  club              Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  branch            ClubBranch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category          StationCategory    @relation(fields: [categoryId], references: [id])
  bookings          Booking[]
  maintenanceBlocks MaintenanceBlock[]
  pricingRules      PricingRule[]
  promotions        Promotion[]

  @@index([clubId, status])
  @@map("stations")
}

/// Weekly schedule. Time strings are "HH:mm" in the club timezone.
/// When closesAt <= opensAt the shift spans midnight (overnight clubs).
model OperatingHours {
  id        Int     @id @default(autoincrement())
  clubId    Int     @map("club_id")
  /// 0 = Monday … 6 = Sunday
  dayOfWeek Int     @map("day_of_week")
  closed    Boolean @default(false)
  opensAt   String? @map("opens_at") @db.VarChar(5)
  closesAt  String? @map("closes_at") @db.VarChar(5)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, dayOfWeek])
  @@map("operating_hours")
}

model SpecialClosure {
  id     Int      @id @default(autoincrement())
  clubId Int      @map("club_id")
  date   DateTime @db.Date
  reason String?  @db.VarChar(255)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, date])
  @@map("special_closures")
}

model MaintenanceBlock {
  id          Int      @id @default(autoincrement())
  stationId   Int      @map("station_id")
  startsAt    DateTime @map("starts_at") @db.Timestamptz
  endsAt      DateTime @map("ends_at") @db.Timestamptz
  reason      String?  @db.VarChar(255)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stationId, startsAt, endsAt])
  @@map("maintenance_blocks")
}

/// Price overrides. Precedence (highest first):
///   1. stationId-specific rules
///   2. categoryId rules
///   3. station base price (Station.pricePerHour)
/// Within the same level, higher `priority` wins; ties break by newer rule id.
/// dayOfWeeks empty = every day. Time window is club-local "HH:mm".
model PricingRule {
  id           Int         @id @default(autoincrement())
  clubId       Int         @map("club_id")
  stationId    Int?        @map("station_id")
  categoryId   Int?        @map("category_id")
  name         String      @db.VarChar(120)
  priority     Int         @default(0)
  dayOfWeeks   Int[]       @default([]) @map("day_of_weeks")
  startsAtTime String?     @map("starts_at_time") @db.VarChar(5)
  endsAtTime   String?     @map("ends_at_time") @db.VarChar(5)
  unit         PricingUnit @default(PER_HOUR)
  amount       BigInt // integer UZS
  active       Boolean     @default(true)

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  station  Station?         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category StationCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([clubId, active])
  @@map("pricing_rules")
}

// ---------------------------------------------------------------------------
// Bookings & payments
// ---------------------------------------------------------------------------

model Booking {
  id             Int           @id @default(autoincrement())
  reference      String        @unique @db.VarChar(20)
  userId         Int           @map("user_id")
  clubId         Int           @map("club_id")
  stationId      Int           @map("station_id")
  /// UTC instants, interval convention: [startsAt, endsAt)
  startsAt       DateTime      @map("starts_at") @db.Timestamptz
  endsAt         DateTime      @map("ends_at") @db.Timestamptz
  status         BookingStatus @default(PENDING)
  priceAmount    BigInt        @map("price_amount") // integer UZS snapshot
  currency       String        @default("UZS") @db.VarChar(3)
  priceSnapshot  Json          @map("price_snapshot")
  paymentMethod  PaymentMethod @default(PAY_AT_CLUB) @map("payment_method")
  paymentStatus  PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  cancelReason   String?       @map("cancel_reason")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelledById  Int?          @map("cancelled_by_id")
  /// For pay-at-club PENDING bookings: auto-expire after this instant.
  expiresAt      DateTime?     @map("expires_at")
  idempotencyKey String?       @map("idempotency_key")
  groupId        Int?          @map("group_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  club    Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  station Station        @relation(fields: [stationId], references: [id], onDelete: Restrict)
  events  BookingEvent[]
  payment Payment?
  review  Review?
  group   GroupBooking?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  promotionRedemptions PromotionRedemption[]
  checkInToken         CheckInToken?
  commissionEntries    CommissionLedgerEntry[]
  loyaltyEntries       LoyaltyLedgerEntry[]
  supportTickets       SupportTicket[]

  @@unique([userId, idempotencyKey])
  @@index([clubId, startsAt])
  @@index([userId, createdAt])
  @@index([stationId, startsAt])
  @@index([status, expiresAt])
  @@index([groupId])
  @@map("bookings")
}

model BookingEvent {
  id          Int            @id @default(autoincrement())
  bookingId   Int            @map("booking_id")
  actorUserId Int?           @map("actor_user_id")
  type        String         @db.VarChar(40)
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus? @map("to_status")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_events")
}

model Payment {
  id             Int           @id @default(autoincrement())
  bookingId      Int           @unique @map("booking_id")
  provider       String        @db.VarChar(40)
  providerRef    String?       @map("provider_ref") @db.VarChar(120)
  amount         BigInt
  currency       String        @default("UZS") @db.VarChar(3)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  commissionEntries CommissionLedgerEntry[]

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Social, support, notifications, audit
// ---------------------------------------------------------------------------

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  clubId    Int      @map("club_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@map("favorites")
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  clubId    Int          @map("club_id")
  bookingId Int          @unique @map("booking_id")
  rating    Int // 1..5
  comment   String?      @db.VarChar(1000)
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@map("reviews")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.VarChar(1000)
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id           Int            @id @default(autoincrement())
  userId       Int?           @map("user_id")
  subject      String         @db.VarChar(200)
  status       TicketStatus   @default(OPEN)
  category     TicketCategory @default(GENERAL)
  priority     TicketPriority @default(NORMAL)
  clubId       Int?           @map("club_id")
  bookingId    Int?           @map("booking_id")
  assignedToId Int?           @map("assigned_to_id")
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user       User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  club       Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  booking    Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignedTo User?                  @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportTicketMessage[]
  events     SupportTicketEvent[]

  @@index([status])
  @@index([clubId, status])
  @@index([assignedToId, status])
  @@map("support_tickets")
}

model SupportTicketEvent {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  actorUserId Int?     @map("actor_user_id")
  type        String   @db.VarChar(40)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_events")
}

model SupportTicketMessage {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @map("ticket_id")
  authorUserId Int?     @map("author_user_id")
  body         String
  fromStaff    Boolean  @default(false) @map("from_staff")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(60)
  metadata    Json?
  ip          String?  @db.VarChar(60)
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Advanced feature A — Smart pricing & promotions
// ---------------------------------------------------------------------------

/// Owner-defined discount. `value` is interpreted per `type`:
///   PERCENT → whole percent (e.g. 20 = 20% off, bounded 1..100)
///   FLAT    → fixed integer UZS deducted from the price
/// Scope narrows by station and/or category; empty dayOfWeeks = every day.
model Promotion {
  id                 Int           @id @default(autoincrement())
  clubId             Int           @map("club_id")
  createdById        Int?          @map("created_by_id")
  code               String?       @db.VarChar(40)
  name               String        @db.VarChar(140)
  description        String?       @db.VarChar(500)
  type               PromotionType
  value              BigInt // percent (1..100) or UZS depending on type
  stationId          Int?          @map("station_id")
  categoryId         Int?          @map("category_id")
  dayOfWeeks         Int[]         @default([]) @map("day_of_weeks")
  startsAtTime       String?       @map("starts_at_time") @db.VarChar(5)
  endsAtTime         String?       @map("ends_at_time") @db.VarChar(5)
  validFrom          DateTime?     @map("valid_from")
  validUntil         DateTime?     @map("valid_until")
  minDurationMinutes Int?          @map("min_duration_minutes")
  maxUsesTotal       Int?          @map("max_uses_total")
  maxUsesPerUser     Int?          @map("max_uses_per_user")
  stackable          Boolean       @default(false)
  priority           Int           @default(0)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  station     Station?              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category    StationCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@unique([clubId, code])
  @@index([clubId, active])
  @@index([stationId])
  @@index([categoryId])
  @@map("promotions")
}

model PromotionRedemption {
  id             Int      @id @default(autoincrement())
  promotionId    Int      @map("promotion_id")
  userId         Int      @map("user_id")
  bookingId      Int?     @map("booking_id")
  clubId         Int      @map("club_id")
  code           String?  @db.VarChar(40)
  discountAmount BigInt   @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([promotionId, bookingId])
  @@index([promotionId, userId])
  @@index([userId, createdAt])
  @@map("promotion_redemptions")
}

// ---------------------------------------------------------------------------
// Advanced feature B — QR check-in
// ---------------------------------------------------------------------------

/// Opaque check-in token for a confirmed booking. Only a SHA-256 hash is stored.
/// Regenerating replaces the hash and resets consumption.
model CheckInToken {
  id           Int       @id @default(autoincrement())
  bookingId    Int       @unique @map("booking_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  consumedById Int?      @map("consumed_by_id")
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consumedBy User?   @relation("CheckInTokenConsumedBy", fields: [consumedById], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("CheckInTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("check_in_tokens")
}

// ---------------------------------------------------------------------------
// Advanced feature C — Loyalty & referrals
// ---------------------------------------------------------------------------

/// Append-only points ledger. Balance = SUM(points). Every mutation carries a
/// unique idempotencyKey so retries never double-credit/double-debit.
model LoyaltyLedgerEntry {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  type           LoyaltyEntryType
  points         Int // signed
  reason         String           @db.VarChar(120)
  bookingId      Int?             @map("booking_id")
  referralId     Int?             @map("referral_id")
  actorUserId    Int?             @map("actor_user_id")
  idempotencyKey String           @unique @map("idempotency_key")
  expiresAt      DateTime?        @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  user     User      @relation("LoyaltyUser", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("LoyaltyActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("loyalty_ledger_entries")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  code      String   @unique @db.VarChar(24)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model Referral {
  id                  Int            @id @default(autoincrement())
  referrerUserId      Int            @map("referrer_user_id")
  referredUserId      Int            @unique @map("referred_user_id")
  code                String         @db.VarChar(24)
  status              ReferralStatus @default(PENDING)
  qualifyingBookingId Int?           @map("qualifying_booking_id")
  rewardPoints        Int            @default(0) @map("reward_points")
  createdAt           DateTime       @default(now()) @map("created_at")
  qualifiedAt         DateTime?      @map("qualified_at")
  rewardedAt          DateTime?      @map("rewarded_at")

  referrer       User                 @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       User                 @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  loyaltyEntries LoyaltyLedgerEntry[]

  @@unique([referrerUserId, referredUserId])
  @@index([referrerUserId, status])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// Advanced feature D — Group bookings
// ---------------------------------------------------------------------------

/// A coordinated booking of several stations for one group/time slot.
/// Each seat is a normal Booking row with `groupId` set, so all existing
/// availability, overlap-constraint and pricing guarantees still apply.
model GroupBooking {
  id             Int                @id @default(autoincrement())
  reference      String             @unique @db.VarChar(24)
  userId         Int                @map("user_id")
  clubId         Int                @map("club_id")
  startsAt       DateTime           @map("starts_at") @db.Timestamptz
  endsAt         DateTime           @map("ends_at") @db.Timestamptz
  status         GroupBookingStatus @default(PENDING)
  seatsRequested Int                @map("seats_requested")
  seatsConfirmed Int                @default(0) @map("seats_confirmed")
  totalAmount    BigInt             @default(0) @map("total_amount")
  currency       String             @default("UZS") @db.VarChar(3)
  notes          String?            @db.VarChar(500)
  idempotencyKey String?            @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user         User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  club         Club                      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  bookings     Booking[]
  participants GroupBookingParticipant[]

  @@unique([userId, idempotencyKey])
  @@index([clubId, startsAt])
  @@index([userId, createdAt])
  @@map("group_bookings")
}

model GroupBookingParticipant {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  userId    Int?     @map("user_id")
  name      String?  @db.VarChar(120)
  email     String?  @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  role             String    @default("MEMBER") @db.VarChar(20) @map("role")
  inviteTokenHash  String?   @db.VarChar(128) @map("invite_token_hash")
  inviteExpiresAt  DateTime? @map("invite_expires_at")
  invitedAt        DateTime? @map("invited_at")
  acceptedAt       DateTime? @map("accepted_at")
  declinedAt       DateTime? @map("declined_at")

  group GroupBooking @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([inviteTokenHash])
  @@map("group_booking_participants")
}

// ---------------------------------------------------------------------------
// Advanced feature E — AI-powered analytics
// ---------------------------------------------------------------------------

/// A generated insight/summary. `provider` is 'heuristic' when computed without
/// an external model, otherwise the configured provider key.
model AiInsight {
  id            Int       @id @default(autoincrement())
  clubId        Int?      @map("club_id")
  kind          String    @db.VarChar(40)
  periodStart   DateTime? @map("period_start")
  periodEnd     DateTime? @map("period_end")
  provider      String    @default("heuristic") @db.VarChar(40)
  model         String?   @db.VarChar(80)
  payload       Json
  generatedById Int?      @map("generated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  club        Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)
  generatedBy User? @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([clubId, kind, createdAt])
  @@map("ai_insights")
}

// ---------------------------------------------------------------------------
// Advanced feature G — Subscription plans & commissions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id            Int                       @id @default(autoincrement())
  key           String                    @unique @db.VarChar(40)
  name          String                    @db.VarChar(120)
  description   String?                   @db.VarChar(500)
  priceAmount   BigInt                    @map("price_amount")
  currency      String                    @default("UZS") @db.VarChar(3)
  billingPeriod SubscriptionBillingPeriod @default(MONTHLY) @map("billing_period")
  commissionBps Int                       @default(0) @map("commission_bps")
  maxStations   Int?                      @map("max_stations")
  features      Json?
  sortOrder     Int                       @default(0) @map("sort_order")
  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  subscriptions ClubSubscription[]

  @@map("subscription_plans")
}

model ClubSubscription {
  id               Int                @id @default(autoincrement())
  clubId           Int                @map("club_id")
  planId           Int                @map("plan_id")
  status           SubscriptionStatus @default(TRIALING)
  startsAt         DateTime           @map("starts_at")
  currentPeriodEnd DateTime           @map("current_period_end")
  trialEndsAt      DateTime?          @map("trial_ends_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  idempotencyKey   String?            @unique @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  club Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([clubId, status])
  @@index([status, currentPeriodEnd])
  @@map("club_subscriptions")
}

/// Immutable commission record per successful charge. `rateBps` is snapshotted
/// from the club's subscription plan (or platform default) at creation time.
model CommissionLedgerEntry {
  id               Int              @id @default(autoincrement())
  clubId           Int              @map("club_id")
  bookingId        Int?             @map("booking_id")
  paymentId        Int?             @map("payment_id")
  baseAmount       BigInt           @map("base_amount")
  rateBps          Int              @map("rate_bps")
  commissionAmount BigInt           @map("commission_amount")
  currency         String           @default("UZS") @db.VarChar(3)
  status           CommissionStatus @default(PENDING)
  reversesId       Int?             @unique @map("reverses_id")
  idempotencyKey   String           @unique @map("idempotency_key")
  createdAt        DateTime         @default(now()) @map("created_at")

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  booking    Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment    Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reverses   CommissionLedgerEntry? @relation("CommissionReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy CommissionLedgerEntry? @relation("CommissionReversal")

  @@index([clubId, createdAt])
  @@index([bookingId])
  @@map("commission_ledger_entries")
}
