# ============================================================
# CyberBook — environment configuration (EXAMPLE ONLY)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- API (services/api) ----------
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
# Public origin of the API (used by web/mobile clients and CORS)
API_BASE_URL=http://localhost:4000

# ---------- Database ----------
# Local (no Docker): postgresql://postgres@localhost:5432/cyberbook
# Docker Compose:    postgresql://cyberbook:cyberbook@localhost:5433/cyberbook
DATABASE_URL=postgresql://postgres@localhost:5432/cyberbook

# ---------- Redis (optional; used for caching/queues when enabled) ----------
REDIS_URL=redis://localhost:6379
# Set to "false" to run without Redis (default for local dev)
REDIS_ENABLED=false

# ---------- Auth ----------
# REQUIRED in production: long random string (>= 32 bytes, e.g. openssl rand -hex 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# Bcrypt cost. 12 is a reasonable default.
BCRYPT_SALT_ROUNDS=12

# ---------- CORS / Web ----------
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# ---------- Localization ----------
DEFAULT_LOCALE=uz
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS

# ---------- Booking rules (platform defaults) ----------
# Pending bookings auto-expire after this many minutes unless confirmed
PENDING_TTL_MINUTES=15
# Cancellation allowed at least this many minutes before start (0 = up to start time)
CANCELLATION_DEADLINE_MINUTES=30
# Default booking lead time / duration limits (hours)
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_MINUTES=12
BOOKING_LEAD_TIME_MINUTES=0
BOOKING_BUFFER_MINUTES=0

# ---------- Platform commission ----------
# Commission is disabled (0) until explicitly enabled with a real agreement.
COMMISSION_ENABLED=false
COMMISSION_BPS=0

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_GENERAL=300

# ---------- External providers (all optional — dev fallbacks documented) ----------
# Email (SMTP). If unset, verification emails are logged in development mode only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (e.g. Play Mobile / Eskiz). If unset, a DEVELOPMENT-ONLY code is returned.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Push (FCM). Service-account JSON path or base64 payload. Optional.
FCM_CREDENTIALS_JSON=

# Maps (Google Maps / Yandex). If unset, web shows list-based view with static fallback.
MAPS_PROVIDER=
MAPS_API_KEY=

# Payments (Payme / Click official APIs). Disabled until configured AND approved.
PAYMENTS_PROVIDER=
PAYMENTS_MERCHANT_ID=
PAYMENTS_SECRET_KEY=

# Telegram bot for owner notifications (optional)
TELEGRAM_BOT_TOKEN=

# ---------- Development aids ----------
# Seed sample (clearly labeled demo) data on startup. NEVER enable in production.
SEED_DEVELOPMENT_DATA=true
# Return dev verification codes in API responses (SMS/email provider not configured).
# MUST be false in production.
DEV_VERIFICATION_FALLBACK=true
